<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.is2.frameworks</groupId>
	<artifactId>market-jsf</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>
	<name>MarketJSF</name>
	<!--Beheko bertsioak batera lan egiten dute.
		Tomcat-eko bertsioa aldatzen bada, orduan dependentzi guztiak aldatu
		beharko dira.
		Tomcat 10.1.x -> Jakarta EE 10
		Servlet 6.0 / EL 5.0 / CDI 4.0 / Faces 4.0
	-->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>17</maven.compiler.release>
		<!-- Jakarta EE 10 bertsioak -->
		<faces.version>4.0.6</faces.version>
		<servlet.version>6.0.0</servlet.version>
		<cdi.version>4.0.1</cdi.version>
		<weld.version>5.1.5.Final</weld.version>
		<junit.version>5.10.2</junit.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>

		<!--Jakarta Faces (JSF) – Mojarra inplementazioa.
			Tomcat-ek ez du JSFa ekartzen, WAR-ren sartu behar da
		-->
		<dependency>
			<groupId>org.glassfish</groupId>
			<artifactId>jakarta.faces</artifactId>
			<version>${faces.version}</version>
		</dependency>
		<!--Servlet API: 'provided' eremua derrigorrezkoa da konpilatzeko
			Tomcatek ematen du, WAR fitxategian sartzen bada klase bikoiztuak
			egongo lirateke
		-->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${servlet.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.enterprise</groupId>
			<artifactId>jakarta.enterprise.cdi-api</artifactId>
			<version>${cdi.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
CDI-ren inplementazioa (Weld). Tomcat-ek ez du CDI ematen
Faces 4.0-ekin CDI-a beharrezkoa da.
-->
		<dependency>
			<groupId>org.jboss.weld.servlet</groupId>
			<artifactId>weld-servlet-shaded</artifactId>
			<version>${weld.version}</version>
		</dependency>
		<!-- Probak: 'test' eremua, ez da WAR-ren sartzen -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.primefaces</groupId>
			<artifactId>primefaces</artifactId>
			<version>15.0.19</version>
			<classifier>jakarta</classifier>
		</dependency>
	</dependencies>
	<build>
		<!-- Izena ezartzen ez bada WAR fitxategia
			login-jsf-0.0.1-SNAPSHOT.war izango litzateke
			Horrela URLa hau izango da: http://localhost:8080/LoginJSF
		-->
		<finalName>MarketJSF</finalName>
		<plugins>
			<!--plugin bakoitzaren bertsioa finkatu behar da. Bestela Maven-
				ek erabakiko du eta kode desberdina lor daiteke makina edo momenu
				desberdinetan
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<!-- Hemendik hartzen du konfigurazioa: maven.compiler.release -->
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.4.0</version>
			</plugin>
			<!-- JUnit 5 probak exekutatzeko beharrezkoa -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>
</project>